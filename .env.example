# Copy to .env (never commit it) or set these in the server's environment.
BASE_URL=https://weatherevidence.com         # public URL; creem redirects buyers back here
DATA_DIR=data                               # SQLite database, snapshots and PDFs
PRICE_CENTS=999                             # shown on the page; the charge itself is the creem product's price

CREEM_API_KEY=creem_test_xxx                # creem_test_… keys use https://test-api.creem.io automatically
CREEM_PRODUCT_ID=prod_xxx                   # one-time $9.99 product
CREEM_WEBHOOK_SECRET=whsec_xxx              # creem dashboard → Developers → Webhook; endpoint: $BASE_URL/webhooks/creem

RESEND_API_KEY=re_xxx
RESEND_FROM="Weather Evidence <reports@weatherevidence.com>"   # a sender on a domain verified in Resend

ADMIN_PASSWORD=change-me                    # /admin (HTTP Basic auth, any username)

# Local testing only: skip creem and mark orders paid at checkout.
# DEV_FAKE_PAYMENTS=1
