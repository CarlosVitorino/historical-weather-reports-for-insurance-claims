# Copy to .env (never commit it) or set these in the server's environment. On the server: deploy/.env.
# Check a filled-in file with: wxreport check [--email-to you@example.com]
BASE_URL=https://weatherevidence.com         # public URL; creem redirects buyers back here
DATA_DIR=data                               # SQLite database, snapshots, PDFs, backups (the container uses /data)
PRICE_CENTS=999                             # shown on the page; the charge itself is the creem product's price

CREEM_API_KEY=creem_test_xxx                # creem_test_… keys use https://test-api.creem.io automatically
CREEM_PRODUCT_ID=prod_xxx                   # one-time $9.99 product
CREEM_WEBHOOK_SECRET=whsec_xxx              # creem dashboard → Developers → Webhook; endpoint: $BASE_URL/webhooks/creem

# Email. weatherevidence.com must be a verified domain in Resend. Reports are sent from RESEND_FROM with replies
# going to support@weatherevidence.com (SUPPORT_EMAIL in wxreport/__init__.py). Failed reports, failed emails,
# new sales, refunds and disputes are reported to ALERT_EMAIL (empty: the support address).
RESEND_API_KEY=re_xxx
RESEND_FROM="Weather Evidence <report@weatherevidence.com>"
ALERT_EMAIL=

# Address autocomplete: free key from https://myprojects.geoapify.com (3,000 requests/day). Without it the form
# falls back to Photon (OpenStreetMap), which misses many US house numbers. Past GEOAPIFY_DAILY_LIMIT calls in a
# UTC day the form falls back to Photon too, so a script can't spend the whole quota.
GEOAPIFY_API_KEY=
GEOAPIFY_DAILY_LIMIT=2500

# Shown on /terms, /privacy, /refunds and /imprint (the Impressum: the operator is in Germany, so § 5 DDG applies
# although buyers are in the US). Until LEGAL_OWNER and LEGAL_ADDRESS are set those pages say "Draft", and creem's
# account review rejects the store. The support address must be a mailbox you read, and the same address as
# creem → Settings → Business Details.
LEGAL_OWNER=                                # your legal name or company
LEGAL_ADDRESS=                              # postal address, lines separated by |: Street 1 | 10115 Berlin | Germany
LEGAL_PHONE=                                # optional second contact for the imprint
LEGAL_VAT_ID=                               # optional: USt-IdNr., if you have one
LEGAL_LAW=Germany                           # country whose law governs the terms

ADMIN_PASSWORD=change-me                    # /admin (HTTP Basic auth, any username)

# Housekeeping, once at start-up and then daily: unpaid drafts older than DRAFT_TTL_HOURS are deleted, and a copy
# of the database goes to DATA_DIR/backups (BACKUP_KEEP days kept). deploy/backup-offsite.sh copies it off the host.
DRAFT_TTL_HOURS=24
BACKUP_KEEP=14

# production: real creem checkout. development: skip creem and mark orders paid at checkout,
# even when the CREEM_* keys above are set. Never use development on the live server.
ENVIRONMENT=production
